# JARVIS Assistant Environment Configuration Template
# Copy this file to .env and insert your API keys.

# NVIDIA Nemotron Reasoning Engine (Primary Reasoning & Coding Brain)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Optional Cloud Providers
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# CEREBRAS_API_KEY=your_cerebras_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional Wakeword & Audio Settings
# PORCUPINE_API_KEY=your_porcupine_key_here
# JARVIS_WAKEWORD_ENGINE=openwakeword
# JARVIS_PRIVACY_MODE=GUARDED
