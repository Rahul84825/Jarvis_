# Goliya / Jarvis Assistant Environment Configuration

# Google Gemini API Key (optional - Goliya runs full offline fallback if missing)
# GEMINI_API_KEY=your_gemini_api_key_here

# Picovoice Porcupine API Key (optional - defaults to mock detector if empty)
# PORCUPINE_API_KEY=your_porcupine_key_here

# Application & Logging Settings (optional overrides)
# JARVIS_LOG_LEVEL=DEBUG
# JARVIS_WAKEWORD_ENGINE=mock
# JARVIS_WHISPER_MODEL=small
# JARVIS_TTS_VOICE=en-US-GuyNeural
